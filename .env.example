# Preview remains private until business approval
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_PUBLIC=false

# Optional CMS - connect the company's own Sanity project
SANITY_PROJECT_ID=
SANITY_DATASET=production
# SANITY_READ_TOKEN=  # ONLY if the dataset is private; server-side only

# Default mailto; switch only after enabling Netlify Forms and testing submissions
NEXT_PUBLIC_PALLAS_FORM_BACKEND=mailto
